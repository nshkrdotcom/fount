        },
        {
          "required": [
            "local_id"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "title_entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "local_id": {
          "type": "string",
          "pattern": "^new:[a-z][a-z0-9_-]*$"
        },
        "key": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "key",
        "values"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
              "local_id"
            ]
          }
        },
        {
          "required": [
            "local_id"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        }
      ]
    }
  }
