      },
      "required": [
        "namespace",
        "kind",
        "target",
        "value",
        "dependencies",
        "status",
        "provenance"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
