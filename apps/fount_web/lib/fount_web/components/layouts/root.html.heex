<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#121512" />
    <title>Fount · Screenplay Desk</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="fount-body">
    <a class="skip-link" href="#fount-content">Skip to workspace</a>
    <noscript><p class="noscript-note" role="status">
      JavaScript is disabled. Saved screenplay pages remain available, but live editing and recovery controls require JavaScript.
    </p></noscript>
    <div id="fount-content" class="app-stage">{@inner_content}</div>
  </body>
</html>
