{
  "$schema": "https://raw.githubusercontent.com/yamadashy/repomix/main/repomix.schema.json",
  "output": {
    "filePath": "fount.xml",
    "style": "xml",
    "parsableStyle": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false
  },
  "include": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "mix.exs",
    "mix.lock",
    ".formatter.exs",
    ".gitignore",
    ".github/**",
    "repomix.config.json",
    "scripts/**",
    "handoff/apply_overlay.py",
    "packages/**",
    "apps/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      "**/.git/**",
      "**/.elixir_ls/**",
      "**/.blitz/**",
      "**/_build/**",
      "**/deps/**",
      "**/doc/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/.env*",
      "fount.xml",
      "repomix-output*.xml",
      "**/*.pdf",
      "**/assets/*.svg",
      "**/*.dump",
      "**/*.tar",
      "**/examples/_downloads/**",
      "**/examples/_output/**"
    ]
  }
}
