{
  "$schema": "https://raw.githubusercontent.com/yamadashy/repomix/main/repomix.schema.json",
  "output": {
    "filePath": "fount.xml",
    "style": "xml",
    "parsableStyle": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false
  },
  "include": [
    "README.md",
    "mix.exs",
    ".formatter.exs",
    ".gitignore",
    "repomix.config.json",
    "packages/*/mix.exs",
    "packages/*/.formatter.exs",
    "packages/*/lib/**",
    "packages/*/priv/repo/migrations/**",
    "apps/fount_web/mix.exs",
    "apps/fount_web/.formatter.exs",
    "apps/fount_web/config/**",
    "apps/fount_web/lib/**",
    "apps/fount_web/priv/repo/migrations/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": false,
    "customPatterns": [
      "**/.git/**",
      "**/.elixir_ls/**",
      "**/.blitz/**",
      "**/_build/**",
      "**/deps/**",
      "**/doc/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/.env*",
      "fount.xml",
      "fount-architecture.xml",
      "repomix-output*.xml",
      "**/*.pdf",
      "**/*.dump",
      "**/*.tar"
    ]
  }
}
