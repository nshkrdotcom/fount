<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#121512" />
    <link rel="icon" href={~p"/fount-icons/favicon.ico"} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={~p"/fount-icons/favicon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/fount-icons/favicon-32x32.png"} />
    <link rel="icon" type="image/png" sizes="16x16" href={~p"/fount-icons/favicon-16x16.png"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/fount-icons/apple-touch-icon.png"} />
    <link rel="mask-icon" href={~p"/fount-icons/safari-pinned-tab.svg"} color="#121512" />
    <link rel="manifest" href={~p"/fount-icons/site.webmanifest"} />
    <meta name="msapplication-TileColor" content="#121512" />
    <meta name="msapplication-config" content={~p"/fount-icons/browserconfig.xml"} />
    <title>Fount · Screenplay Desk</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="fount-body">
    <a class="skip-link" href="#fount-content">Skip to workspace</a>
    <noscript><p class="noscript-note" role="status">
      JavaScript is disabled. Saved screenplay pages remain available, but live editing and recovery controls require JavaScript.
    </p></noscript>
    <div id="fount-content" class="app-stage">{@inner_content}</div>
  </body>
</html>
