<main class="login-shell">
  <section class="login-identity" aria-labelledby="login-title">
    <p class="eyebrow">Screenplay development</p>
    <h1 id="login-title">Fount</h1>
    <p class="login-deck">
      Read, revise and develop your screenplay. Review proposed changes before approving a new version.
    </p>
  </section>
  <section class="login-panel">
    <p class="micro-label">Sign in</p>
    <h2>Enter the workspace</h2>
    <p>
      Enter your workspace access token.
    </p>
    <p :if={@error} class="ui-alert ui-alert--error" role="alert">{@error}</p>
    <form action={~p"/login"} method="post" class="stack">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <label>
        Access token
        <input name="session[token]" type="password" autocomplete="current-password" required />
      </label>
      <button type="submit">Sign in to Fount</button>
    </form>
  </section>
</main>
