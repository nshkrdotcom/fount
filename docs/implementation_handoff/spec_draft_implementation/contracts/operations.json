  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "screenplay",
            "revision",
            "scene",
            "element",
            "dialogue_block",
            "character",
            "title_entry",
            "authored_item"
          ]
        },
        "id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "string",
              "pattern": "^new:[a-z][a-z0-9_-]*$"
            }
          ]
        },
        "span": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "byte_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "byte_end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "byte_start",
                "byte_end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "element": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "keep": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "keep"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "local_id": {
              "type": "string",
              "pattern": "^new:[a-z][a-z0-9_-]*$"
            },
            "type": {
              "enum": [
                "action",
                "character",
                "dialogue",
                "parenthetical",
                "transition",
                "centered",
                "lyric",
                "section",
                "synopsis",
                "page_break",
                "note",
                "boneyard",
                "blank"
              ]
            },
            "text": {
              "type": "string"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "character_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "string",
                      "pattern": "^new:[a-z][a-z0-9_-]*$"
                    }
                  ]
                },
                "dual_with_cue": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "string",
                      "pattern": "^new:[a-z][a-z0-9_-]*$"
                    }
                  ]
                },
                "dual_side": {
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "forced": {
                  "type": "boolean"
                },
                "level": {
                  "type": "integer",
                  "minimum": 1
                },
                "metadata": {
                  "type": "object"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "text",
            "attrs"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "id"
              ],
              "not": {
                "required": [
                  "local_id"
                ]
              }
            },
            {
              "required": [
                "local_id"
              ],
              "not": {
                "required": [
                  "id"
                ]
              }
            }
          ]
        }
      ]
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "local_id": {
          "type": "string",
          "pattern": "^new:[a-z][a-z0-9_-]*$"
        },
        "heading": {
          "type": "string"
        },
        "number": {
          "type": [
            "string",
            "null"
          ]
        },
        "omitted": {
          "type": "boolean"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          },
          "minItems": 0
        }
      },
      "required": [
        "heading",
        "elements"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
              "local_id"
            ]
          }
        },
        {
          "required": [
            "local_id"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "character": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "local_id": {
          "type": "string",
          "pattern": "^new:[a-z][a-z0-9_-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alias": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            },
            "required": [
              "alias",
              "kind"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "attributes": {
          "type": "object"
        }
      },
      "required": [
        "display_name",
        "aliases",
        "attributes"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
              "local_id"
            ]
          }
        },
        {
          "required": [
            "local_id"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "authored_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "local_id": {
          "type": "string",
          "pattern": "^new:[a-z][a-z0-9_-]*$"
        },
        "namespace": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "brief",
            "story_plan",
            "note",
            "constraint",
            "fact",
            "voice_direction",
            "sequence",
            "storyline",
            "story_time",
            "perspective_access"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "value": {
          "type": "object"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 0
        },
        "status": {
          "enum": [
            "active",
            "unresolved",
            "resolved"
          ]
        },
        "provenance": {
          "type": "object"
